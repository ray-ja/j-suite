# --- Live data (never commit business/customer data) ---
data.json
business-app-backup-*.json

# --- Company document vault (EIN, insurance, COI — server-only, never commit) ---
company-docs/

# --- Secrets (QuickBooks OAuth keys & tokens) ---
qb-config.json
qb-tokens.json
.env

# --- CEO read-path token (read-only sweep credential; never commit) ---
ceo-config.json

# --- Web-push VAPID keypair + sync-token env (server-only secrets; never commit) ---
vapid-config.json
sync.env

# --- Per-user sync tokens (token -> userId map; server-only, never synced/committed) ---
user-tokens.json

# --- Reply-watcher: dev-box tokens (read+write to prod) + cursor (THE SWITCH; never commit) ---
watcher-config.json
tools/.reply-watcher-cursor.json
tools/.ops-sweep-cursor.json
tools/.ops-brief-cursor.json
tools/.watcher-heartbeat.json
.reply-watcher.log
.watcher-daemon.log

# --- User-uploaded photos / receipts (server-only blobs; never commit) ---
uploads/

# --- Office lock & temp files ---
~$*
.~lock.*#
*.tmp

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Node ---
node_modules/
npm-debug.log*

# --- Editor ---
.vscode/
.idea/

_sync_probe.txt
*.bak
.devserver.log

# --- Dev-only overrides (bypass + seeder; dev-box only, NEVER prod/committed) ---
dev-overrides/
